generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum RoleName {
  OWNER
  ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
  ACCOUNTANT
}
enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
}
model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String?       @unique
  phone        String        @unique
  passwordHash String
  role         RoleName
  branchId     Int?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  staffProfile StaffProfile?
  appointments Appointment[] @relation("AppointmentStaff")
}
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}
model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?
  gender       String?
  dob          DateTime?
  notes        String?
  branchId     Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}
model ServiceCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  services Service[]
}
model Service {
  id                  Int                  @id @default(autoincrement())
  name                String
  categoryId          Int
  category            ServiceCategory      @relation(fields: [categoryId], references: [id])
  price               Decimal              @db.Decimal(10, 2)
  durationMin         Int                  @default(30)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointmentServices AppointmentService[]
  packageServices     PackageService[]
}
model StaffProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id])
  designation       String?
  joiningDate       DateTime?
  baseSalary        Decimal   @default(0) @db.Decimal(10, 2)
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)
}
model Appointment {
  id           Int                  @id @default(autoincrement())
  customerId   Int
  customer     Customer             @relation(fields: [customerId], references: [id])
  staffId      Int?
  staff        User?                @relation("AppointmentStaff", fields: [staffId], references: [id])
  startAt      DateTime
  endAt        DateTime
  status       AppointmentStatus    @default(SCHEDULED)
  isWalkIn     Boolean              @default(false)
  notes        String?
  cancelReason String?
  branchId     Int?
  createdById  Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  services     AppointmentService[]
  @@index([startAt])
  @@index([staffId, startAt])
}
model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     Int
  service       Service     @relation(fields: [serviceId], references: [id])
  price         Decimal     @db.Decimal(10, 2)
  durationMin   Int
}
enum ProductUsage {
  SALE
  SALON_USE
  BOTH
}
enum StockMoveType {
  IN
  OUT
  ADJUST
  SALE
  DAMAGED
  USED
}
model Product {
  id            Int             @id @default(autoincrement())
  name          String
  sku           String?         @unique
  category      String?
  unit          String          @default("piece")
  usage         ProductUsage    @default(SALE)
  costPrice     Decimal         @default(0) @db.Decimal(10, 2)
  salePrice     Decimal         @default(0) @db.Decimal(10, 2)
  stockQty      Decimal         @default(0) @db.Decimal(12, 3)
  lowStockLevel Decimal         @default(0) @db.Decimal(12, 3)
  expiryDate    DateTime?
  isActive      Boolean         @default(true)
  branchId      Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movements     StockMovement[]
}
model StockMovement {
  id           Int           @id @default(autoincrement())
  productId    Int
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         StockMoveType
  qty          Decimal       @db.Decimal(12, 3)
  balanceAfter Decimal       @db.Decimal(12, 3)
  note         String?
  createdById  Int?
  createdAt    DateTime      @default(now())
  @@index([productId, createdAt])
}

enum PackageKind {
  COMBO
  MEMBERSHIP
  SESSION
}
model Package {
  id           Int              @id @default(autoincrement())
  name         String
  kind         PackageKind      @default(COMBO)
  description  String?
  price        Decimal          @db.Decimal(10, 2)
  validityDays Int              @default(30)
  sessionCount Int?
  isActive     Boolean          @default(true)
  branchId     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  services     PackageService[]
}
model PackageService {
  id        Int     @id @default(autoincrement())
  packageId Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])
  @@unique([packageId, serviceId])
}

model MembershipPlan {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  validityDays    Int      @default(365)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  branchId        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
