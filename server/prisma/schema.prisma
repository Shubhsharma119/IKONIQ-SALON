generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum RoleName {
  OWNER
  ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
  ACCOUNTANT
}
enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
}
model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String?       @unique
  phone        String        @unique
  passwordHash String
  role         RoleName
  branchId     Int?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  staffProfile StaffProfile?
  appointments Appointment[] @relation("AppointmentStaff")
}
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}
model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?
  gender       String?
  dob          DateTime?
  notes        String?
  branchId     Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  invoices Invoice[]
  customerPackages CustomerPackage[]
  customerMemberships CustomerMembership[]
  walletBalance Decimal @default(0) @db.Decimal(12, 2)
  walletTransactions WalletTransaction[]
}
model ServiceCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  isDeleted Boolean @default(false)
  services Service[]
}
model Service {
  id                  Int                  @id @default(autoincrement())
  name                String
  categoryId          Int
  category            ServiceCategory      @relation(fields: [categoryId], references: [id])
  price               Decimal              @db.Decimal(10, 2)
  durationMin         Int                  @default(30)
  isActive            Boolean              @default(true)
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointmentServices AppointmentService[]
  packageServices     PackageService[]
}
model StaffProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id])
  designation       String?
  joiningDate       DateTime?
  baseSalary        Decimal   @default(0) @db.Decimal(10, 2)
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)
}
model Appointment {
  id           Int                  @id @default(autoincrement())
  customerId   Int
  customer     Customer             @relation(fields: [customerId], references: [id])
  staffId      Int?
  staff        User?                @relation("AppointmentStaff", fields: [staffId], references: [id])
  startAt      DateTime
  endAt        DateTime
  status       AppointmentStatus    @default(SCHEDULED)
  isWalkIn     Boolean              @default(false)
  notes        String?
  cancelReason String?
  branchId     Int?
  createdById  Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  services     AppointmentService[]
  @@index([startAt])
  @@index([staffId, startAt])
}
model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     Int
  service       Service     @relation(fields: [serviceId], references: [id])
  price         Decimal     @db.Decimal(10, 2)
  durationMin   Int
}
enum ProductUsage {
  SALE
  SALON_USE
  BOTH
}
enum StockMoveType {
  IN
  OUT
  ADJUST
  SALE
  DAMAGED
  USED
}
model Product {
  id            Int             @id @default(autoincrement())
  name          String
  sku           String?         @unique
  category      String?
  unit          String          @default("piece")
  usage         ProductUsage    @default(SALE)
  costPrice     Decimal         @default(0) @db.Decimal(10, 2)
  salePrice     Decimal         @default(0) @db.Decimal(10, 2)
  stockQty      Decimal         @default(0) @db.Decimal(12, 3)
  lowStockLevel Decimal         @default(0) @db.Decimal(12, 3)
  expiryDate    DateTime?
  isActive      Boolean         @default(true)
  branchId      Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movements     StockMovement[]
}
model StockMovement {
  id           Int           @id @default(autoincrement())
  productId    Int
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         StockMoveType
  qty          Decimal       @db.Decimal(12, 3)
  balanceAfter Decimal       @db.Decimal(12, 3)
  note         String?
  createdById  Int?
  createdAt    DateTime      @default(now())
  @@index([productId, createdAt])
}

enum PackageKind {
  COMBO
  MEMBERSHIP
  SESSION
}
model Package {
  id           Int              @id @default(autoincrement())
  name         String
  kind         PackageKind      @default(COMBO)
  description  String?
  price        Decimal          @db.Decimal(10, 2)
  validityDays Int              @default(30)
  sessionCount Int?
  isActive     Boolean          @default(true)
  branchId     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  services     PackageService[]
}
model PackageService {
  id        Int     @id @default(autoincrement())
  packageId Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])
  @@unique([packageId, serviceId])
}

model MembershipPlan {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  validityDays    Int      @default(365)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  branchId        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK
  WALLET
}
enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  CANCELLED
}
enum InvoiceItemType {
  SERVICE
  PRODUCT
  PACKAGE
  MEMBERSHIP
  SESSION_USE
  CUSTOM
}
model InvoiceCounter {
  id     Int    @id @default(autoincrement())
  key    String @unique
  lastNo Int    @default(0)
}
model Invoice {
  id                 Int           @id @default(autoincrement())
  invoiceNo          String        @unique
  customerId         Int?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  guestName          String?
  appointmentId      Int?          @unique
  isGst              Boolean       @default(false)
  gstRate            Decimal       @default(0) @db.Decimal(5, 2)
  subtotal           Decimal       @db.Decimal(10, 2)
  membershipDiscount Decimal       @default(0) @db.Decimal(10, 2)
  discountType       String?
  discountValue      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(10, 2)
  taxableAmount      Decimal       @db.Decimal(10, 2)
  gstAmount          Decimal       @default(0) @db.Decimal(10, 2)
  total              Decimal       @db.Decimal(10, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(10, 2)
  status             InvoiceStatus
  notes              String?
  branchId           Int?
  createdById        Int?
  createdAt          DateTime      @default(now())
  items              InvoiceItem[]
  payments           Payment[]
  @@index([createdAt])
}
model InvoiceItem {
  id                Int             @id @default(autoincrement())
  invoiceId         Int
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType          InvoiceItemType
  serviceId         Int?
  productId         Int?
  packageId         Int?
  membershipPlanId  Int?
  customerPackageId Int?
  staffId           Int?
  name              String
  qty               Decimal         @default(1) @db.Decimal(12, 3)
  price             Decimal         @db.Decimal(10, 2)
  amount            Decimal         @db.Decimal(10, 2)
}
model Payment {
  id          Int         @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  mode        PaymentMode
  amount      Decimal     @db.Decimal(10, 2)
  reference   String?
  balanceAfter Decimal? @db.Decimal(12, 2)
  createdById Int?
  createdAt   DateTime    @default(now())
  @@index([createdAt])
}
model CustomerPackage {
  id            Int          @id @default(autoincrement())
  customerId    Int
  customer      Customer     @relation(fields: [customerId], references: [id])
  packageId     Int
  invoiceId     Int?
  name          String
  kind          String
  sessionsTotal Int?
  sessionsUsed  Int          @default(0)
  purchasedAt   DateTime     @default(now())
  expiresAt     DateTime
  uses          SessionUse[]
  @@index([customerId, expiresAt])
}
model SessionUse {
  id                Int             @id @default(autoincrement())
  customerPackageId Int
  customerPackage   CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  invoiceId         Int?
  serviceId         Int
  serviceName       String
  staffId           Int?
  usedById          Int?
  usedAt            DateTime        @default(now())
}
model CustomerMembership {
  id              Int      @id @default(autoincrement())
  customerId      Int
  customer        Customer @relation(fields: [customerId], references: [id])
  planId          Int
  invoiceId       Int?
  name            String
  discountPercent Decimal  @db.Decimal(5, 2)
  price           Decimal  @db.Decimal(10, 2)
  startsAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  @@index([customerId, expiresAt])
}

enum WalletTxnType {
  TOPUP
  PAYMENT
  ADJUSTMENT
}
model WalletOffer {
  id           Int      @id @default(autoincrement())
  name         String
  payAmount    Decimal  @db.Decimal(10, 2)
  creditAmount Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}
model WalletTransaction {
  id           Int           @id @default(autoincrement())
  customerId   Int
  customer     Customer      @relation(fields: [customerId], references: [id])
  type         WalletTxnType
  amount       Decimal       @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(12, 2)
  bonusAmount  Decimal       @default(0) @db.Decimal(12, 2)
  mode         PaymentMode?
  reference    String?
  offerName    String?
  invoiceId    Int?
  balanceAfter Decimal       @db.Decimal(12, 2)
  note         String?
  createdById  Int?
  createdAt    DateTime      @default(now())
  @@index([customerId, createdAt])
  @@index([createdAt])
}
model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  isActive Boolean   @default(true)
  expenses Expense[]
}
model Expense {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(10, 2)
  mode        PaymentMode
  expenseDate DateTime
  payee       String?
  reference   String?
  note        String?
  isVoid      Boolean         @default(false)
  voidReason  String?
  voidedAt    DateTime?
  voidedById  Int?
  branchId    Int?
  createdById Int?
  createdAt   DateTime        @default(now())
  @@index([expenseDate])
}
model Supplier {
  id            Int               @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstin         String?
  address       String?
  notes         String?
  isActive      Boolean           @default(true)
  branchId      Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  purchases     Purchase[]
  payments      SupplierPayment[]
  @@index([name])
}
model Purchase {
  id         Int               @id @default(autoincrement())
  purchaseNo String            @unique
  supplierId Int
  supplier   Supplier          @relation(fields: [supplierId], references: [id])
  billNo     String?
  billDate   DateTime
  subtotal   Decimal           @db.Decimal(12, 2)
  gstAmount  Decimal           @default(0) @db.Decimal(12, 2)
  total      Decimal           @db.Decimal(12, 2)
  paidAmount Decimal           @default(0) @db.Decimal(12, 2)
  note       String?
  isVoid     Boolean           @default(false)
  voidReason String?
  voidedAt   DateTime?
  voidedById Int?
  branchId   Int?
  createdById Int?
  createdAt  DateTime          @default(now())
  items      PurchaseItem[]
  payments   SupplierPayment[]
  @@index([supplierId, billDate])
  @@index([billDate])
}
model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  name       String
  qty        Decimal  @db.Decimal(12, 3)
  rate       Decimal  @db.Decimal(10, 2)
  gstRate    Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount  Decimal  @default(0) @db.Decimal(12, 2)
  amount     Decimal  @db.Decimal(12, 2)
}
model SupplierPayment {
  id          Int         @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  purchaseId  Int?
  purchase    Purchase?   @relation(fields: [purchaseId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  mode        PaymentMode
  reference   String?
  note        String?
  isVoid      Boolean     @default(false)
  voidReason  String?
  voidedAt    DateTime?
  voidedById  Int?
  createdById Int?
  createdAt   DateTime    @default(now())
  @@index([supplierId, createdAt])
}
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

