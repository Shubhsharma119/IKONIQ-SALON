import { useEffect, useState, type FormEvent } from 'react';
import { Link } from 'react-router-dom';
import { Wallet as WalletIcon, Plus, Pencil, Power, Search } from 'lucide-react';
import { api } from '../api';
import { useAuth } from '../auth';
import Modal from '../components/Modal';
import Field, { inputCls } from '../components/Field';
import WalletTopUp, { type Offer } from '../components/WalletTopUp';
import { useToast } from '../components/Toast';

type Balances = {
  totalBalance: number;
  customersWithBalance: number;
  monthPaid: number;
  monthBonus: number;
  customers: { id: number; name: string; phone: string; walletBalance: string | number }[];
};
type Cust = { id: number; name: string; phone: string; isActive: boolean };
const r2 = (x: number) => Math.round(x * 100) / 100;
const inr = (x: number) => '\u20B9' + x.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
export default function WalletPage() {
  const toast = useToast();
  const { user } = useAuth();
  const isManager = ['OWNER', 'ADMIN', 'MANAGER'].includes(user?.role || '');
  const [data, setData] = useState<Balances | null>(null);
  const [offers, setOffers] = useState<Offer[]>([]);
  const [q, setQ] = useState('');
  const [results, setResults] = useState<Cust[]>([]);
  const [topCust, setTopCust] = useState<Cust | null>(null);
  const [form, setForm] = useState<{ id: number | null; name: string; pay: string; credit: string } | null>(null);
  const [busy, setBusy] = useState(false);
  function load() {
    Promise.all([api<Balances>('/wallet/balances'), api<Offer[]>('/wallet/offers')])
      .then(([b, o]) => {
        setData(b);
        setOffers(o);
      })
      .catch((e) => toast.show('error', e.message));
  }
  useEffect(load, []);
  useEffect(() => {
    if (!q.trim()) {
      setResults([]);
      return;
    }
    const t = setTimeout(() => {
      api<Cust[]>('/customers?q=' + encodeURIComponent(q.trim()))
        .then((r) => setResults(r.filter((c) => c.isActive).slice(0, 6)))
        .catch(() => setResults([]));
    }, 250);
    return () => clearTimeout(t);
  }, [q]);
  async function saveOffer(e: FormEvent) {
    e.preventDefault();
    if (!form) return;
    const pay = Number(form.pay);
    const credit = Number(form.credit);
    if (form.name.trim().length < 2) return toast.show('error', 'Enter the offer name (at least 2 letters).');
    if (!(pay > 0)) return toast.show('error', 'Enter the amount the customer pays.');
    if (!(credit >= pay)) return toast.show('error', 'Wallet credit must be equal to or more than the amount paid.');
    setBusy(true);
    try {
      await api(form.id ? '/wallet/offers/' + form.id : '/wallet/offers', {
        method: form.id ? 'PUT' : 'POST',
        body: JSON.stringify({ name: form.name.trim(), payAmount: pay, creditAmount: credit }),
      });
      toast.show('success', form.id ? 'Offer updated successfully.' : 'Offer added successfully.');
      setForm(null);
      load();
    } catch (err: any) {
      toast.show('error', err.message === 'Invalid data' ? 'Please check the details and try again.' : err.message);
    } finally {
      setBusy(false);
    }
  }
  async function toggle(o: Offer) {
    try {
      await api('/wallet/offers/' + o.id, { method: 'PUT', body: JSON.stringify({ isActive: !o.isActive }) });
      toast.show('success', o.isActive ? 'Offer deactivated.' : 'Offer activated.');
      load();
    } catch (err: any) {
      toast.show('error', err.message);
    }
  }
  const stat = (label: string, value: string, tone: string) => (
    <div className="rounded-2xl border border-slate-200 bg-white p-4">
      <div className="text-sm text-slate-500">{label}</div>
      <div className={'text-2xl font-bold ' + tone}>{value}</div>
    </div>
  );
  const fpay = form ? Number(form.pay) || 0 : 0;
  const fcredit = form ? Number(form.credit) || 0 : 0;
  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <WalletIcon size={22} />
          </div>
          <div>
            <h1 className="text-2xl font-bold text-slate-800">E-Wallet</h1>
            <p className="text-sm text-slate-500">Customer prepaid balance, offers and recharge</p>
          </div>
        </div>
      </div>
      {data && (
        <div className="grid grid-cols-2 gap-3 xl:grid-cols-4">
          {stat('Total wallet balance', inr(data.totalBalance), 'text-slate-800')}
          {stat('Customers with balance', String(data.customersWithBalance), 'text-slate-800')}
          {stat('Recharged this month', inr(data.monthPaid), 'text-emerald-600')}
          {stat('Extra given this month', inr(data.monthBonus), 'text-amber-600')}
        </div>
      )}
      <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div className="mb-2 text-sm font-semibold text-slate-800">Add money to a customer's wallet</div>
        <div className="relative max-w-md">
          <Search size={16} className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
          <input className={inputCls + ' pl-9'} placeholder="Search customer by name or mobile" value={q} onChange={(e) => setQ(e.target.value)} />
        </div>
        {results.length > 0 && (
          <ul className="mt-1 max-w-md divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white shadow-sm">
            {results.map((c) => (
              <li key={c.id}>
                <button type="button" onClick={() => { setTopCust(c); setQ(''); }} className="flex w-full items-center justify-between px-3 py-2 text-left text-sm hover:bg-slate-50">
                  <span className="text-slate-800">{c.name}</span>
                  <span className="text-slate-500">+91 {c.phone}</span>
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>
      <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div className="mb-3 flex items-center justify-between">
          <div className="text-sm font-semibold text-slate-800">Recharge offers</div>
          {isManager && (
            <button onClick={() => setForm({ id: null, name: '', pay: '', credit: '' })} className="inline-flex items-center gap-1 rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700">
              <Plus size={14} /> Add offer
            </button>
          )}
        </div>
        {offers.length === 0 && <div className="text-sm text-slate-400">No offers yet. Add one, for example: pay 10000, get 15000.</div>}
        <div className="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
          {offers.map((o) => {
            const pay = Number(o.payAmount);
            const credit = Number(o.creditAmount);
            return (
              <div key={o.id} className={'rounded-xl border p-3 ' + (o.isActive ? 'border-slate-200' : 'border-slate-200 opacity-50')}>
                <div className="flex items-start justify-between">
                  <div className="font-medium text-slate-800">{o.name}</div>
                  <span className={'rounded-full px-2 py-0.5 text-xs font-medium ' + (o.isActive ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500')}>
                    {o.isActive ? 'Active' : 'Inactive'}
                  </span>
                </div>
                <div className="mt-1 text-sm text-slate-600">Pay {inr(pay)}, get {inr(credit)} in wallet</div>
                <div className="text-xs font-medium text-emerald-700">
                  Extra {inr(r2(credit - pay))} ({pay > 0 ? r2(((credit - pay) / pay) * 100) : 0}%)
                </div>
                {isManager && (
                  <div className="mt-2 flex gap-1 text-slate-400">
                    <button onClick={() => setForm({ id: o.id, name: o.name, pay: String(pay), credit: String(credit) })} title="Edit" className="rounded-lg p-2 hover:bg-indigo-50 hover:text-indigo-600"><Pencil size={16} /></button>
                    <button onClick={() => toggle(o)} title={o.isActive ? 'Deactivate' : 'Activate'} className="rounded-lg p-2 hover:bg-rose-50 hover:text-rose-600"><Power size={16} /></button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
      <div className="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div className="border-b border-slate-100 px-5 py-3 text-sm font-semibold text-slate-800">Customers with wallet balance</div>
        <table className="w-full text-sm">
          <thead className="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th className="px-5 py-3 font-semibold">Customer</th>
              <th className="px-5 py-3 font-semibold">Mobile</th>
              <th className="px-5 py-3 text-right font-semibold">Balance</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-100">
            {data && data.customers.length === 0 && (
              <tr><td colSpan={3} className="px-5 py-10 text-center text-slate-400">No customer has wallet balance yet.</td></tr>
            )}
            {data && data.customers.map((c) => (
              <tr key={c.id} className="hover:bg-slate-50/60">
                <td className="px-5 py-3"><Link to={'/customers/' + c.id} className="font-medium text-indigo-700 hover:underline">{c.name}</Link></td>
                <td className="px-5 py-3 text-slate-600">+91 {c.phone}</td>
                <td className="px-5 py-3 text-right font-semibold text-slate-800">{inr(Number(c.walletBalance))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {topCust && <WalletTopUp customer={topCust} onClose={() => setTopCust(null)} onDone={load} />}
      {form && (
        <Modal title={form.id ? 'Edit offer' : 'Add recharge offer'} subtitle="Example: customer pays 10000, wallet gets 15000." onClose={() => setForm(null)}>
          <form onSubmit={saveOffer} className="space-y-4" noValidate>
            <Field label="Offer name" required>
              <input className={inputCls} placeholder="e.g. Diwali Offer" value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} />
            </Field>
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <Field label={'Customer pays (\u20B9)'} required>
                <input className={inputCls} type="number" min="0" step="any" placeholder="10000" value={form.pay} onChange={(e) => setForm({ ...form, pay: e.target.value })} />
              </Field>
              <Field label={'Wallet credit (\u20B9)'} required hint="Total amount added to the wallet.">
                <input className={inputCls} type="number" min="0" step="any" placeholder="15000" value={form.credit} onChange={(e) => setForm({ ...form, credit: e.target.value })} />
              </Field>
            </div>
            <div className="rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
              Extra amount: {inr(Math.max(0, r2(fcredit - fpay)))}
            </div>
            <div className="flex justify-end gap-2 border-t border-slate-100 pt-4">
              <button type="button" onClick={() => setForm(null)} className="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
              <button disabled={busy} className="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60">
                {busy ? 'Saving...' : 'Save offer'}
              </button>
            </div>
          </form>
        </Modal>
      )}
    </div>
  );
}

